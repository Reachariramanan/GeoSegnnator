FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/package-lock.json* ./

# Install dependencies
RUN npm install

# Copy entire frontend directory (preserves all CSS, HTML, configs)
COPY frontend/ ./

# Build the app
RUN npm run build

# Use nginx for production
FROM nginx:alpine
WORKDIR /etc/nginx

# Copy nginx config
COPY nginx.conf conf.d/default.conf

# Copy built app
COPY --from=0 /app/dist /usr/share/nginx/html

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]
